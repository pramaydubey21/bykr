# Superuser connection: used only by scripts/seed.ts to apply DDL and seed data.
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/bykr
# Application connection: non-superuser role bykr_app, so row level security applies.
DATABASE_URL=postgres://bykr_app:bykr_app@localhost:5432/bykr
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=bykr
# Auth.js secret. Any long random string; generate with: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string
AUTH_TRUST_HOST=true
